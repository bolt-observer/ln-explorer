# Copy to .env only if you want to override the defaults.
# `docker compose up -d --build` works with no .env file.

# rgs (default) | lnd | file
GRAPH_SOURCE=rgs

# Public LDK rapid gossip sync snapshot. Full topology, about 2 MB.
RGS_URL=https://rapidsync.lightningdevkit.org/snapshot/0

# Public mempool.space Lightning API for aliases, capacity, search, and history.
# Set to empty to disable.
MEMPOOL_API=https://mempool.space/api

# How often the in-process job re-downloads the snapshot, in seconds. 0 = once at startup.
REFRESH_SECONDS=10800

# Individual node profiles still missing an alias after the bulk lists, paced by ENRICH_RPS.
# A non-429 error is skipped. HTTP 429 backs off and stops the batch.
ENRICH_PER_REFRESH=6000
ENRICH_RPS=3

# Mempool channel-list requests per refresh, highest-degree nodes first.
# The first request for a node returns up to 1000 channels (index=-1). A longer
# list continues in pages of 10. Progress is stored in sqlite, so coverage
# climbs on the following refreshes. HTTP 429 stops the batch; other errors
# skip that node and leave it unfinished.
CAPACITY_PAGES_PER_REFRESH=800

# Sampled betweenness / closeness. 64 is plenty on the public graph.
METRICS_SAMPLES=64

# Mempool channel-close lookups per refresh (GET /v1/lightning/channels/<id>).
# An unresolved close is retried at most 6 times, no more than once per 12h.
CLOSE_LOOKUPS_PER_REFRESH=150

# Per-day rank history keeps the top N nodes per metric (365 days).
RANK_HISTORY_TOP=200

# Optional own node. Used when GRAPH_SOURCE=lnd, and as a fallback if RGS fails
# while these are set. LND's REST cert is self-signed; LND_INSECURE=1 skips verification.
# LND_REST_URL=https://127.0.0.1:8080
# LND_MACAROON_HEX=
# LND_MACAROON_PATH=/data/admin.macaroon
# LND_INSECURE=1

# Optional describegraph JSON or .bin RGS snapshot, when GRAPH_SOURCE=file.
# GRAPH_FILE=/data/describegraph.json

# Cookieless Plausible. Leave the domain empty to load nothing.
# PLAUSIBLE_DOMAIN=explorer.example.com
# PLAUSIBLE_SRC=https://plausible.io/js/script.js
# Newer per-site scripts (…/js/pa-XXXX.js) need only PLAUSIBLE_SRC, no domain.

PORT=8000
DATA_DIR=/data
